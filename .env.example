# =============================================================================
# 密钥与部署连接（勿提交真实生产密钥）
# 服务行为 / 分类型文件规则 → 见 config.yaml
# 本机：conda activate dev2609 后 ./scripts/dev.sh（不自动使用仓库 .venv）
# =============================================================================

# ── Deploy mode ──────────────────────────────────────────────────────────
# lite (default): SQLite + local filesystem
# full: PostgreSQL + S3/MinIO
# Docker：
#   本地（lite + 热更）：docker compose up -d --build
# 交付 compose 不在本仓库，由交付流程单独生成。
DEPLOY_MODE=lite

# Lite defaults (relative paths work for host `uvicorn`)
DATABASE_URL=sqlite:///./data/db/file_service.db
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data

# Optional: override config.yaml path (default: ./config.yaml)
# CONFIG_PATH=./config.yaml

# 异步任务后端：local = 本机单进程 BackgroundTasks；celery = 投递 worker
# Docker compose 会设 PARSE_TASK_BACKEND=celery
# PARSE_TASK_BACKEND=local

# Docker / Celery（compose 已内置 Valkey；本机双进程调试时自行起 redis/valkey）
# VALKEY_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Full-mode examples (only when DEPLOY_MODE=full):
# DATABASE_URL=postgresql+psycopg://file_service:file_service@localhost:5435/file_service
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9010
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=file-service
# S3_REGION=us-east-1
# S3_USE_SSL=false

# ── Secrets ──────────────────────────────────────────────────────────────
# API 鉴权（Authorization: Bearer <key>）始终开启、不可关闭。
# 逗号分隔多个 key。若留空或不设置，进程启动时会自动生成 ephemeral key 并打印到日志
# （重启会变化；生产请显式配置）。
API_KEYS=dev-api-key

# 开发控制台（静态 MPA）。本地 docker-compose.yml 默认 true；交付环境应关闭。
# 开启时用 DEV_CONSOLE_API_TOKEN 注入浏览器 Bearer（与 API_KEYS 之一一致），勿把生产密钥写进镜像。
# DEV_CONSOLE_ENABLED=false
# DEV_CONSOLE_API_TOKEN=
# DEV_CONSOLE_TENANT_ID=agent-system-a

# UC 工作台跳转（默认关；只认 env，不读 config.yaml）
# 本项目前缀优先，也认 DASHBOARD_UC_* 别名
# FILE_SERVICE_UC_ENABLED=0
# FILE_SERVICE_UC_BASE_URL=http://127.0.0.1
# FILE_SERVICE_UC_SESSION_SECRET=
# FILE_SERVICE_UC_MOCK=0
# 本机测跳转（内网禁止 MOCK）：
# FILE_SERVICE_UC_ENABLED=1
# FILE_SERVICE_UC_MOCK=1
# → http://127.0.0.1:8020/auth?token=local-dev

# 可选：允许的 tenant id 白名单（逗号分隔）。
# 留空 = 调用方任意传递 X-Tenant-Id；配置后仅列表内合法（含 clone 的 target_tenant_id）。
# ALLOWED_TENANT_IDS=tenant-a,tenant-b

# 可选：API key → 租户绑定（覆盖全局白名单的更细粒度）。
# 格式：key1:tenant-a|tenant-b,key2:*   （* = 该 key 可访问任意租户，仍受 ALLOWED_TENANT_IDS 约束）
# 未配置 = 旧行为（仅全局白名单）。
# API_KEY_TENANT_MAP=dev-api-key:tenant-a|tenant-b

# LiteLLM 代理密钥（base_url / 模型名在 config.yaml）
LITELLM_API_KEY=sk-dev-key

# MinerU token（使用 mineru layout 时）
MINERU_API_TOKEN=

# vision-pages 正文识别后端（LAYOUT_PARSER_NAME=vision-pages；非 layout 引擎）
# LAYOUT_PARSER_NAME=vision-pages
# VISION_PAGES_MODEL=kimi-k2.6:cloud

# 可选：本地调试时强制同步解析（一般保持 false；单元测试会自行设置）
# PARSE_SYNC=false
