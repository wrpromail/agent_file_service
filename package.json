{
  "name": "agent-file-service-web",
  "private": true,
  "description": "ESLint tooling for Agent File Service dev-console static UI (web/)",
  "type": "module",
  "scripts": {
    "lint": "eslint --config eslint.config.mjs \"web/shared/**/*.js\" \"web/shared/config.js\"",
